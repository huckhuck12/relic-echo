{
  "name": "relic-echo",
  "version": "0.15.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "build:wechat": "node scripts/build-wechat.mjs",
    "preview:pages": "node scripts/serve.mjs --root _site --base /relic-echo",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "perf": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "perf:browser": "npm run build && node scripts/benchmark-browser.mjs",
    "check:mobile": "npm run build && node scripts/check-mobile-browser.mjs",
    "check:wechat": "npm run build:wechat && node scripts/check-mobile-browser.mjs --wechat",
    "check:balance": "npm run build && node scripts/check-build-balance.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
